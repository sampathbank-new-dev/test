# Copy this file to .env (in the backend folder) and fill in your database details.
# .env is never committed to Git, because it contains the password.

# On your PC with a local MySQL: DB_HOST=127.0.0.1 and DB_SSL=false
# On the server with Amazon RDS: DB_HOST=<your RDS endpoint> and DB_SSL=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cbl_shop
DB_SSL=false
